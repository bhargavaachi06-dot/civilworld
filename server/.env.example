# CivilWorld Server Environment Configuration Example
# Copy this file to .env and adjust values for your environment

NODE_ENV=development
PORT=5000

# Dedicated MongoDB Database for CivilWorld (NEVER point to any other application database)
MONGODB_URI=mongodb://localhost:27017/civilworld_db

# Security & Authentication
# Generate a strong 64-character secret string for production
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here
JWT_EXPIRES_IN=24h
COOKIE_EXPIRES_DAYS=1

# Client Origin for CORS
CLIENT_URL=http://localhost:5173
